package org.poc.objs.policy.sbom.assessment;

import org.poc.objs.policy.drools.EntityFact;
import org.poc.objs.policy.drools.EdgeFact;
import org.poc.objs.policy.drools.DroolsEvaluationScratch;

global DroolsEvaluationScratch scratch;

rule "sbom-no-proprietary-dual-license"
when
    $c : EntityFact( type == "Component", $cid : id != null )
    $edge : EdgeFact( role == "LICENSED_UNDER", source == $cid, $lid : target != null )
    EntityFact(
        id == $lid,
        type == "License",
        eval(
            get("spdxId") != null &&
            String.valueOf(get("spdxId")).equalsIgnoreCase("LicenseRef-Meridian")
        )
    )
then
    String id = $c.getId().toString();
    scratch.fail("Component licensed under proprietary LicenseRef-Meridian");
    scratch.finding(
        "Proprietary dual-license edge present",
        "WARN",
        "SBOM_PROPRIETARY_LICENSE",
        id,
        null
    );
end
