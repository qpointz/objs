# Optional post-transform cleanup for export copies (OUT_DIR paths only).
# Copy this file to scripts/export/cleanup.yml and edit after your first dry-run.
#
# delete_dirs / delete_files are relative to OUT_DIR (not bom-poc source).
delete_dirs:
  - .gitlab
  - deploy
  - docs/workitems
delete_files:
  - .gitlab-ci.yml
  - AGENTS.md
  - VERSION
# Literal replacements run after the built-in package/module transformations.
# If omitted, all supported source-file extensions are searched.
replace: []
# Example:
# replace:
#   - old: "CUSTOM_EXPORT_MARKER"
#     new: "platform"
#     exts:
#       - .kt
#       - .kts
