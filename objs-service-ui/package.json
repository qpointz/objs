    "@codemirror/lint": "^6.9.7",
    "@dagrejs/dagre": "^3.0.0",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@tabler/icons-react": "^3.46.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
