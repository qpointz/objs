    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
